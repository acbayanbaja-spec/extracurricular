# Centrala National High School - Extracurricular System Backend Configuration
PORT=5000
NODE_ENV=development

# Database configuration
# Leave DATABASE_URL empty or point to postgresql://postgres:password@db.supabase.co:5432/postgres
# When DATABASE_URL is not set, the system automatically runs with an embedded relational database (local.db)
DATABASE_URL=

# Supabase Credentials (optional for cloud object storage & cloud PostgreSQL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security & JWT Tokens
JWT_SECRET=cnhs_surallah_south_cotabato_extracurricular_secret_2026_xyz
JWT_REFRESH_SECRET=cnhs_surallah_south_cotabato_extracurricular_refresh_secret_2026_xyz
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000
